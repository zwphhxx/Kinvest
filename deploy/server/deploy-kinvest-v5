#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 3>&2
exec 2>/dev/null

KINVEST_DEPLOY_PROTOCOL='5'
BUNDLE_UID='0'
BUNDLE_GID='10001'
ROOT_UID='0'
ROOT_GID='0'
ROOT='/root/docker/kinvest'
RUN_ROOT='/run'
STATE_ROOT="$ROOT/state"
BACKUP_ROOT="$ROOT/backups"
ACCESS_BUNDLE_ROOT="$RUN_ROOT/kinvest-secrets"
IFIND_BUNDLE_ROOT="$RUN_ROOT/kinvest-ifind-secrets"
CURRENT_STATE="$STATE_ROOT/current.state"
PREVIOUS_STATE="$STATE_ROOT/previous.state"
ATTEMPT_STATE="$STATE_ROOT/attempt.state"
JOURNAL="$STATE_ROOT/deploy-v5.journal"
BEFORE_STATE="$STATE_ROOT/deploy-v5-current.before"
DATABASE="$ROOT/data/kinvest.sqlite"
COMPOSE="$ROOT/docker-compose-v5.yml"
CONTRACT='/usr/local/libexec/kinvest-deploy-v5-contract'
RUNTIME_HELPER='/usr/local/libexec/kinvest-deploy-v5-runtime'
OFFLINE_ATTESTATION='/usr/local/libexec/kinvest-offline-image-attestation'
NETWORK_CONFIG='/etc/kinvest/metadata-network.conf'
PUBLIC_HEALTH_URL='https://dearmina.cn/api/health'

fail() { printf '%s\n' "$1" >&3; exit "${2:-1}"; }
bootstrap_capture=''
bootstrap_cleanup() {
  [[ -n "$bootstrap_capture" && "$bootstrap_capture" == "$RUN_ROOT"/kinvest-v5.bootstrap.* ]] && rm -f -- "$bootstrap_capture" 2>/dev/null || true
}
bootstrap_command() {
  local code="$1" status=0
  shift
  bootstrap_capture="$(mktemp "$RUN_ROOT/kinvest-v5.bootstrap.XXXXXX" 2>/dev/null)" || fail "$code"
  chmod 0600 "$bootstrap_capture" 2>/dev/null || { bootstrap_cleanup; fail "$code"; }
  "$@" >"$bootstrap_capture" 2>&1 || status=$?
  bootstrap_cleanup
  bootstrap_capture=''
  [[ "$status" -eq 0 ]] || fail "$code"
}
trap bootstrap_cleanup EXIT
trap 'bootstrap_cleanup; exit 129' HUP
trap 'bootstrap_cleanup; exit 130' INT
trap 'bootstrap_cleanup; exit 143' TERM
[[ "$#" -eq 0 ]] || fail DEPLOY_V5_ARGUMENTS_FORBIDDEN 2
[[ "$(id -u)" -eq 0 ]] || fail DEPLOY_V5_ROOT_REQUIRED
[[ -x "$CONTRACT" && -x "$RUNTIME_HELPER" && -x "$OFFLINE_ATTESTATION" && -f "$COMPOSE" && ! -L "$COMPOSE" ]] || fail DEPLOY_V5_ASSETS_MISSING
[[ "$(findmnt -n -o FSTYPE --target "$RUN_ROOT" 2>/dev/null)" == tmpfs ]] || fail DEPLOY_V5_RUN_NOT_TMPFS
bootstrap_command DEPLOY_V5_INITIALIZE_FAILED install -d -o root -g root -m 0700 -- "$STATE_ROOT" "$BACKUP_ROOT" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT"
exec 9>"$STATE_ROOT/deploy.lock" 2>/dev/null || fail DEPLOY_V5_INITIALIZE_FAILED
bootstrap_command DEPLOY_V5_LOCKED flock -n 9

payload_file=''
prepared_file=''
current_json=''
previous_json=''
plan_file=''
target_file=''
candidate_state=''
candidate_access_id='none'
candidate_access_path="$ACCESS_BUNDLE_ROOT/disabled"
candidate_ifind_id='none'
candidate_ifind_path=''
candidate_registry=''
candidate_keep='false'
transaction_started='false'
current_image=''
current_access_path=''
current_ifind_path=''
stable_output=''
stable_error=''
candidate_state_text=''

safe_runtime_file() { [[ -n "${1:-}" && "$1" == "$RUN_ROOT"/kinvest-v5.* ]]; }

secure_temp() {
  local variable="$1" template="$2" value
  value="$(mktemp "$template" 2>/dev/null)" || return 1
  if ! chmod 0600 "$value" 2>/dev/null; then rm -f -- "$value" 2>/dev/null || true; return 1; fi
  printf -v "$variable" '%s' "$value"
}

json_field() {
  python3 - "$1" "$2" 2>/dev/null <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding='ascii') as stream:
        value = json.load(stream)[sys.argv[2]]
    print(json.dumps(value, separators=(',', ':'), sort_keys=True) if isinstance(value, (dict, list)) else value)
except Exception:
    raise SystemExit(1)
PY
}

run_docker() { timeout --signal=TERM --kill-after=10s 120s docker "$@"; }

run_stable_command() {
  local code="$1" status=0
  shift
  secure_temp stable_output "$RUN_ROOT/kinvest-v5.command-out.XXXXXX" || fail DEPLOY_V5_CAPTURE_FAILED
  secure_temp stable_error "$RUN_ROOT/kinvest-v5.command-err.XXXXXX" || { rm -f -- "$stable_output" 2>/dev/null; stable_output=''; fail DEPLOY_V5_CAPTURE_FAILED; }
  "$@" >"$stable_output" 2>"$stable_error" || status=$?
  if ! rm -f -- "$stable_output" "$stable_error" 2>/dev/null; then
    fail DEPLOY_V5_CAPTURE_CLEANUP_FAILED
  fi
  stable_output=''; stable_error=''
  [[ "$status" -eq 0 ]] || fail "$code"
}

remove_tree_safe() {
  local root="$1" id="$2" path entry
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || return 0
  path="$root/$id"
  [[ "$path" == "$root"/* && -d "$path" && ! -L "$path" ]] || return 0
  chmod 0700 "$path" || return 1
  while IFS= read -r -d '' entry; do
    [[ -f "$entry" && ! -L "$entry" ]] || return 1
    rm -f -- "$entry" || return 1
  done < <(find "$path" -mindepth 1 -maxdepth 1 -print0)
  rmdir -- "$path"
}

prune_bundle_root() {
  local root="$1" keep="$2" entry id
  [[ -d "$root" && ! -L "$root" ]] || return 1
  while IFS= read -r -d '' entry; do
    id="${entry##*/}"
    [[ "$id" == disabled ]] && continue
    [[ "$id" =~ ^[0-9a-f]{32}$ ]] || return 1
    [[ " $keep " == *" $id "* ]] || remove_tree_safe "$root" "$id"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -print0)
}

collect_referenced_bundle_ids() {
  local field="$1" file parsed id values=''
  for file in "$CURRENT_STATE" "$PREVIOUS_STATE"; do
    [[ -f "$file" && ! -L "$file" ]] || continue
    secure_temp parsed "$RUN_ROOT/kinvest-v5.reference.XXXXXX" || return 1
    if "$CONTRACT" parse-state <"$file" >"$parsed" 2>/dev/null; then
      id="$(json_field "$parsed" "$field")" || { rm -f -- "$parsed"; return 1; }
      [[ "$id" == none ]] || values+=" $id"
    else
      rm -f -- "$parsed"
      return 1
    fi
    rm -f -- "$parsed"
  done
  printf '%s\n' "$values"
}

prune_access_bundles() { prune_bundle_root "$ACCESS_BUNDLE_ROOT" "$(collect_referenced_bundle_ids secretBundleId)"; }
prune_ifind_bundles() { prune_bundle_root "$IFIND_BUNDLE_ROOT" "$(collect_referenced_bundle_ids ifindSecretBundleId)"; }

atomic_state_from_json() {
  local source="$1" target="$2" prefix="$3" temporary
  secure_temp temporary "$STATE_ROOT/.${prefix}-v5.XXXXXX" || return 1
  if ! "$CONTRACT" canonical-state <"$source" >"$temporary" 2>/dev/null; then
    rm -f -- "$temporary"; return 1
  fi
  mv -f -- "$temporary" "$target" 2>/dev/null
}

atomic_state_from_text() {
  local source="$1" target="$2" prefix="$3" temporary
  secure_temp temporary "$STATE_ROOT/.${prefix}-v5.XXXXXX" || return 1
  cat -- "$source" >"$temporary" 2>/dev/null || { rm -f -- "$temporary"; return 1; }
  mv -f -- "$temporary" "$target" 2>/dev/null
}

write_journal() {
  local phase="$1" temporary
  secure_temp temporary "$STATE_ROOT/.deploy-v5-journal.XXXXXX" || return 1
  python3 - "$temporary" "$phase" "$intent" "$candidate_access_id" "$candidate_ifind_id" 2>/dev/null <<'PY' || { rm -f -- "$temporary"; return 1; }
import json, os, sys
path, phase, intent, access_id, ifind_id = sys.argv[1:]
value = {'version': 1, 'phase': phase, 'intent': intent, 'candidateAccessId': access_id, 'candidateIfindId': ifind_id}
fd = os.open(path, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
try:
    os.fchmod(fd, 0o600)
    os.write(fd, (json.dumps(value, separators=(',', ':'), sort_keys=True) + '\n').encode('ascii'))
    os.fsync(fd)
finally: os.close(fd)
PY
  mv -f -- "$temporary" "$JOURNAL" 2>/dev/null
}

compose_state_file() {
  local state_file="$1" parsed image provider_value versions_value access_id access_path access_value proxies_value ifind_value ifind_version_value ifind_id ifind_path profile service
  secure_temp parsed "$RUN_ROOT/kinvest-v5.compose-state.XXXXXX" || return 1
  "$CONTRACT" parse-state <"$state_file" >"$parsed" 2>/dev/null || { rm -f -- "$parsed"; return 1; }
  image="$(json_field "$parsed" runtimeImageId)" || { rm -f -- "$parsed"; return 1; }
  provider_value="$(json_field "$parsed" secretProviderMode)" || { rm -f -- "$parsed"; return 1; }
  versions_value="$(json_field "$parsed" secretVersionIds)" || { rm -f -- "$parsed"; return 1; }
  access_id="$(json_field "$parsed" secretBundleId)" || { rm -f -- "$parsed"; return 1; }
  access_value="$(json_field "$parsed" accessControlMode)" || { rm -f -- "$parsed"; return 1; }
  proxies_value="$(json_field "$parsed" trustedProxyAddresses)" || { rm -f -- "$parsed"; return 1; }
  ifind_value="$(json_field "$parsed" ifindDiagnosticMode)" || { rm -f -- "$parsed"; return 1; }
  ifind_version_value="$(json_field "$parsed" ifindRefreshTokenVersionId)" || { rm -f -- "$parsed"; return 1; }
  ifind_id="$(json_field "$parsed" ifindSecretBundleId)" || { rm -f -- "$parsed"; return 1; }
  rm -f -- "$parsed"
  [[ "$access_id" == none ]] && access_path="$ACCESS_BUNDLE_ROOT/disabled" || access_path="$ACCESS_BUNDLE_ROOT/$access_id"
  if [[ "$ifind_value" == diagnostic ]]; then
    profile=ifind-diagnostic; service=kinvest-diagnostic; ifind_path="$IFIND_BUNDLE_ROOT/$ifind_id"
  else
    profile=ifind-disabled; service=kinvest-disabled; ifind_path=''
  fi
  (
    export COMPOSE_PROFILES="$profile" KINVEST_IMAGE="$image"
    export KINVEST_SECRET_PROVIDER_MODE="$provider_value" KINVEST_SECRET_VERSION_IDS="$versions_value"
    export KINVEST_SECRET_BUNDLE_HOST_PATH="$access_path" KINVEST_ACCESS_CONTROL_MODE="$access_value"
    export KINVEST_TRUSTED_PROXY_ADDRESSES="$proxies_value"
    export KINVEST_IFIND_REFRESH_TOKEN_VERSION_ID="$ifind_version_value" KINVEST_IFIND_SECRET_BUNDLE_HOST_PATH="$ifind_path"
    run_docker compose -f "$COMPOSE" --env-file "$NETWORK_CONFIG" up -d --remove-orphans "$service" >/dev/null 2>&1
  )
}

restore_previous_runtime() {
  [[ -f "$BEFORE_STATE" && ! -L "$BEFORE_STATE" ]] || return 1
  compose_state_file "$BEFORE_STATE" || return 1
  atomic_state_from_text "$BEFORE_STATE" "$CURRENT_STATE" current || return 1
}

reconcile_transaction_journal() {
  [[ -e "$JOURNAL" ]] || return 0
  [[ -f "$JOURNAL" && ! -L "$JOURNAL" && -f "$BEFORE_STATE" && ! -L "$BEFORE_STATE" ]] || return 1
  local phase journal_intent access_id ifind_id
  phase="$(json_field "$JOURNAL" phase)" || return 1
  journal_intent="$(json_field "$JOURNAL" intent)" || return 1
  access_id="$(json_field "$JOURNAL" candidateAccessId)" || return 1
  ifind_id="$(json_field "$JOURNAL" candidateIfindId)" || return 1
  case "$phase" in
    prepared)
      remove_tree_safe "$ACCESS_BUNDLE_ROOT" "$access_id" || return 1
      remove_tree_safe "$IFIND_BUNDLE_ROOT" "$ifind_id" || return 1
      ;;
    compose-active)
      restore_previous_runtime || return 1
      remove_tree_safe "$ACCESS_BUNDLE_ROOT" "$access_id" || return 1
      remove_tree_safe "$IFIND_BUNDLE_ROOT" "$ifind_id" || return 1
      ;;
    state-committed)
      compose_state_file "$CURRENT_STATE" || return 1
      if [[ "$journal_intent" != RESTORE ]]; then atomic_state_from_text "$BEFORE_STATE" "$PREVIOUS_STATE" previous || return 1; fi
      ;;
    *) return 1 ;;
  esac
  rm -f -- "$ATTEMPT_STATE" "$JOURNAL" "$BEFORE_STATE"
  prune_access_bundles && prune_ifind_bundles
}

cleanup() {
  local status=$?
  trap - EXIT
  if [[ -n "$candidate_registry" && -f "$candidate_registry" && ! -L "$candidate_registry" ]]; then
    "$RUNTIME_HELPER" recover "$candidate_registry" "$RUN_ROOT" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT" "$ROOT_UID" "$ROOT_GID" >/dev/null 2>&1 || true
  fi
  if [[ -e "$JOURNAL" ]]; then
    if ! reconcile_transaction_journal >/dev/null 2>&1; then
      printf '%s\n' DEPLOY_V5_RECOVERY_FAILED >&3
      status=70
      candidate_keep='true'
    fi
  elif [[ "$candidate_keep" != true ]]; then
    remove_tree_safe "$ACCESS_BUNDLE_ROOT" "$candidate_access_id" >/dev/null 2>&1 || true
    remove_tree_safe "$IFIND_BUNDLE_ROOT" "$candidate_ifind_id" >/dev/null 2>&1 || true
  fi
  for file in "$payload_file" "$prepared_file" "$current_json" "$previous_json" "$plan_file" "$target_file" "$candidate_state" "$candidate_state_text" "$stable_output" "$stable_error" "$candidate_registry"; do
    if safe_runtime_file "$file"; then
      shred -u -z -- "$file" 2>/dev/null || true
      rm -f -- "$file" 2>/dev/null || true
    fi
  done
  exit "$status"
}
trap - EXIT HUP INT TERM
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

reconcile_transaction_journal >/dev/null 2>&1 || fail DEPLOY_V5_RECOVERY_FAILED 70

recover_stale_candidate_registries() {
  local registry
  shopt -s nullglob
  for registry in "$RUN_ROOT"/kinvest-v5.candidates.*; do
    [[ "$registry" == *.tmp.* ]] && continue
    "$RUNTIME_HELPER" recover "$registry" "$RUN_ROOT" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT" "$ROOT_UID" "$ROOT_GID" >/dev/null 2>&1 || return 1
  done
  shopt -u nullglob
}
recover_stale_candidate_registries || fail DEPLOY_V5_CANDIDATE_RECOVERY_FAILED 70

secure_temp payload_file "$RUN_ROOT/kinvest-v5.payload.XXXXXX" || fail DEPLOY_V5_PAYLOAD_FILE_FAILED
run_stable_command DEPLOY_V5_PAYLOAD_READ_FAILED dd bs=4096 count=5 of="$payload_file" status=none
[[ "$(wc -c <"$payload_file" | tr -d '[:space:]')" -le 16384 ]] || fail DEPLOY_V5_PAYLOAD_TOO_LARGE 2
grep -Fqx 'KINVEST_DEPLOY_V5' <(head -n 1 "$payload_file") || fail DEPLOY_V5_PAYLOAD_REJECTED 2

secure_temp prepared_file "$RUN_ROOT/kinvest-v5.prepared.XXXXXX" || fail DEPLOY_V5_PAYLOAD_FILE_FAILED
"$CONTRACT" validate-payload <"$payload_file" >"$prepared_file" 2>/dev/null || fail DEPLOY_V5_PAYLOAD_REJECTED 2

secure_temp candidate_registry "$RUN_ROOT/kinvest-v5.candidates.XXXXXX" || fail DEPLOY_V5_CANDIDATE_REGISTRY_FAILED
bundle_result="$("$RUNTIME_HELPER" materialize "$payload_file" "$RUN_ROOT" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT" \
  "$BUNDLE_UID" "$BUNDLE_GID" "$ROOT_UID" "$ROOT_GID" "$candidate_registry" 2>/dev/null)" || fail DEPLOY_V5_BUNDLE_CREATE_FAILED
# HELPER_WINDOW_AFTER_SUCCESS_BEFORE_ID_RECORD
candidate_access_id="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["accessId"])' 2>/dev/null <<<"$bundle_result")" || fail DEPLOY_V5_BUNDLE_CREATE_FAILED
candidate_access_path="$ACCESS_BUNDLE_ROOT/$candidate_access_id"
candidate_ifind_id="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["ifindId"])' 2>/dev/null <<<"$bundle_result")" || fail DEPLOY_V5_BUNDLE_CREATE_FAILED
candidate_ifind_path="$IFIND_BUNDLE_ROOT/$candidate_ifind_id"
# REGISTRY_WINDOW_AFTER_ID_RECORD
unset bundle_result

if [[ "$candidate_access_id" == none ]]; then
  candidate_access_path="$ACCESS_BUNDLE_ROOT/disabled"
  run_stable_command DEPLOY_V5_INITIALIZE_FAILED install -d -o root -g 10001 -m 0550 -- "$candidate_access_path"
fi
if [[ "$candidate_ifind_id" == none ]]; then candidate_ifind_path=''; fi

secure_temp current_json "$RUN_ROOT/kinvest-v5.current.XXXXXX" || fail DEPLOY_V5_STATE_READ_FAILED
secure_temp previous_json "$RUN_ROOT/kinvest-v5.previous.XXXXXX" || fail DEPLOY_V5_STATE_READ_FAILED
[[ -f "$CURRENT_STATE" && ! -L "$CURRENT_STATE" ]] || fail DEPLOY_V5_CURRENT_STATE_MISSING
"$CONTRACT" parse-state <"$CURRENT_STATE" >"$current_json" 2>/dev/null || fail DEPLOY_V5_CURRENT_STATE_INVALID
if [[ -e "$PREVIOUS_STATE" ]]; then
  [[ -f "$PREVIOUS_STATE" && ! -L "$PREVIOUS_STATE" ]] || fail DEPLOY_V5_PREVIOUS_STATE_INVALID
  "$CONTRACT" parse-state <"$PREVIOUS_STATE" >"$previous_json" 2>/dev/null || fail DEPLOY_V5_PREVIOUS_STATE_INVALID
else
  printf 'null\n' >"$previous_json"
fi

secure_temp plan_file "$RUN_ROOT/kinvest-v5.plan.XXXXXX" || fail DEPLOY_V5_STATE_READ_FAILED
if ! python3 - "$prepared_file" "$current_json" "$previous_json" 2>/dev/null <<'PY' | "$CONTRACT" resolve-intent >"$plan_file" 2>/dev/null
import json, sys
with open(sys.argv[1]) as stream: request = json.load(stream)
with open(sys.argv[2]) as stream: current = json.load(stream)
with open(sys.argv[3]) as stream: previous = json.load(stream)
request_fields = (
    'imageDigest', 'commit', 'secretProviderMode', 'secretVersionIds',
    'secretMaterialFingerprints', 'accessControlMode', 'ifindDiagnosticMode',
    'ifindRefreshTokenVersionId', 'ifindSecretMaterialFingerprint',
)
projected = {key: request[key] for key in request_fields}
print(json.dumps({'intent': request['intent'], 'request': projected, 'current': current, 'previous': previous}, separators=(',', ':'), sort_keys=True))
PY
then
  fail DEPLOY_V5_INTENT_RESOLUTION_FAILED
fi
[[ -s "$plan_file" ]] || fail DEPLOY_V5_INTENT_RESOLUTION_FAILED

intent="$(json_field "$prepared_file" intent)"
if [[ "$intent" == FORWARD ]]; then
  target_digest="$(json_field "$prepared_file" imageDigest)"
  target_commit="$(json_field "$prepared_file" commit)"
  target_verification_run_id="$(json_field "$prepared_file" verificationRunId)"
  target_file="$prepared_file"
else
  secure_temp target_file "$RUN_ROOT/kinvest-v5.target.XXXXXX" || fail DEPLOY_V5_STATE_READ_FAILED
  if ! python3 - "$plan_file" >"$target_file" 2>/dev/null <<'PY'
import json, sys
with open(sys.argv[1]) as stream: print(json.dumps(json.load(stream)['target'], separators=(',', ':'), sort_keys=True))
PY
  then
    fail DEPLOY_V5_INTENT_RESOLUTION_FAILED
  fi
  [[ -s "$target_file" ]] || fail DEPLOY_V5_INTENT_RESOLUTION_FAILED
  target_digest="$(json_field "$target_file" imageDigest)"
  target_commit="$(json_field "$target_file" commit)"
  target_verification_run_id="$(json_field "$target_file" verificationRunId)"
fi
ifind_mode="$(json_field "$prepared_file" ifindDiagnosticMode)"
ifind_version="$(json_field "$prepared_file" ifindRefreshTokenVersionId)"
access_mode="$(json_field "$prepared_file" accessControlMode)"
provider="$(json_field "$prepared_file" secretProviderMode)"
versions="$(json_field "$prepared_file" secretVersionIds)"

inspect_id() { run_docker image inspect "$1" --format '{{.Id}}' 2>/dev/null; }
read_label() { run_docker image inspect "$1" --format "{{index .Config.Labels \"$2\"}}" 2>/dev/null; }
verify_repo_digest() { run_docker image inspect "$1" --format '{{json .RepoDigests}}' 2>/dev/null | grep -Fq -- "\"$2\""; }

resolve_offline_image() {
  local id
  id="$(timeout 15s "$OFFLINE_ATTESTATION" resolve "$target_digest" "$target_commit" "$target_verification_run_id" 2>/dev/null)" || return 1
  [[ "$id" =~ ^sha256:[0-9a-f]{64}$ && "$(inspect_id "$id")" == "$id" ]] || return 1
  verify_repo_digest "$id" "$target_digest" || return 1
  printf '%s\n' "$id"
}

attested_image_id="$(resolve_offline_image)" || fail DEPLOY_V5_IMAGE_PROVENANCE_INVALID
if [[ "$intent" == FORWARD ]]; then
  runtime_image_id="$attested_image_id"
else
  runtime_image_id="$(json_field "$target_file" runtimeImageId)"
  [[ "$runtime_image_id" == "$attested_image_id" ]] || fail DEPLOY_V5_IMAGE_PROVENANCE_INVALID
fi

schema_before="$(python3 - "$DATABASE" 2>/dev/null <<'PY'
import sqlite3, sys
with sqlite3.connect('file:' + sys.argv[1] + '?mode=ro', uri=True) as db: print(db.execute('PRAGMA user_version').fetchone()[0])
PY
)" || fail DEPLOY_V5_SCHEMA_READ_FAILED
schema_min="$(read_label "$runtime_image_id" io.kinvest.schema.min)"
schema_max="$(read_label "$runtime_image_id" io.kinvest.schema.max)"
[[ "$schema_min" =~ ^[0-9]+$ && "$schema_max" =~ ^[0-9]+$ && "$schema_before" -ge "$schema_min" && "$schema_before" -le "$schema_max" ]] || fail ROLLBACK_REQUIRES_DB_RESTORE 75
[[ "$(read_label "$runtime_image_id" io.kinvest.access-control.contract)" == 1 ]] || fail DEPLOY_V5_ACCESS_CONTRACT_INVALID
if [[ "$ifind_mode" == diagnostic ]]; then
  [[ "$(read_label "$runtime_image_id" io.kinvest.ifind-secret-bootstrap)" == 1 ]] || fail DEPLOY_V5_IFIND_PROVIDER_INCOMPATIBLE
fi

run_access_preflight() {
  run_docker run --rm --network none --read-only --cap-drop ALL --user 10001:10001 \
    --volume "$candidate_access_path:/run/secrets/kinvest:ro" \
    --env "KINVEST_SECRET_PROVIDER_MODE=$provider" --env "KINVEST_SECRET_VERSION_IDS=$versions" \
    --env KINVEST_SECRET_BUNDLE_PATH=/run/secrets/kinvest \
    --entrypoint node "$runtime_image_id" server/secret-preflight.js
}

run_ifind_preflight() {
  [[ "$ifind_mode" == diagnostic ]] || return 0
  run_docker run --rm --network none --read-only --cap-drop ALL --user 10001:10001 \
    --volume "$candidate_ifind_path:/run/secrets/kinvest-ifind:ro" \
    --env KINVEST_IFIND_DIAGNOSTIC_MODE=admin-diagnostic \
    --env "KINVEST_IFIND_REFRESH_TOKEN_VERSION_ID=$ifind_version" \
    --env KINVEST_IFIND_SECRET_BUNDLE_PATH=/run/secrets/kinvest-ifind \
    --entrypoint node "$runtime_image_id" server/ifind-secret-preflight.js
}

run_stable_command DEPLOY_V5_ACCESS_PREFLIGHT_FAILED run_access_preflight
run_stable_command DEPLOY_V5_IFIND_PREFLIGHT_FAILED run_ifind_preflight

verify_backup_file() {
  python3 - "$1" "$2" "$BACKUP_ROOT" 2>/dev/null <<'PY'
import hashlib, os, stat, sys
path, expected, root = sys.argv[1:]
if os.path.abspath(path) != path or os.path.islink(root) or os.path.realpath(os.path.dirname(path)) != os.path.realpath(root) or os.path.basename(path) in ('', '.', '..'):
    raise SystemExit(1)
root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
fd = os.open(os.path.basename(path), os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1: raise SystemExit(1)
    digest = hashlib.file_digest(os.fdopen(os.dup(fd), 'rb'), 'sha256').hexdigest()
    if digest != expected: raise SystemExit(1)
finally:
    os.close(fd)
    os.close(root_fd)
PY
}

verify_state_backup_references() {
  local state_file="$1" path checksum
  [[ -f "$state_file" && ! -L "$state_file" ]] || return 1
  path="$(json_field "$state_file" databaseBackupPath)" || return 1
  checksum="$(json_field "$state_file" databaseBackupChecksum)" || return 1
  if [[ "$path" == none && "$checksum" == none ]]; then return 0; fi
  [[ "$path" != none && "$checksum" =~ ^[0-9a-f]{64}$ ]] || return 1
  verify_backup_file "$path" "$checksum"
}

verify_state_backup_references "$current_json" || fail DEPLOY_V5_EXISTING_BACKUP_INVALID
if ! grep -Fqx null "$previous_json"; then
  verify_state_backup_references "$previous_json" || fail DEPLOY_V5_EXISTING_BACKUP_INVALID
fi
if [[ "$intent" != FORWARD ]]; then
  verify_state_backup_references "$target_file" || fail DEPLOY_V5_EXISTING_BACKUP_INVALID
fi

