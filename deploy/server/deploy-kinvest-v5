#!/usr/bin/env bash
set -euo pipefail
umask 077

KINVEST_DEPLOY_PROTOCOL='5'
ROOT='/root/docker/kinvest'
RUN_ROOT='/run'
STATE_ROOT="$ROOT/state"
BACKUP_ROOT="$ROOT/backups"
ACCESS_BUNDLE_ROOT="$RUN_ROOT/kinvest-secrets"
IFIND_BUNDLE_ROOT="$RUN_ROOT/kinvest-ifind-secrets"
CURRENT_STATE="$STATE_ROOT/current.state"
PREVIOUS_STATE="$STATE_ROOT/previous.state"
ATTEMPT_STATE="$STATE_ROOT/attempt.state"
JOURNAL="$STATE_ROOT/deploy-v5.journal"
DATABASE="$ROOT/data/kinvest.sqlite"
COMPOSE="$ROOT/docker-compose-v5.yml"
CONTRACT='/usr/local/libexec/kinvest-deploy-v5-contract'
OFFLINE_ATTESTATION='/usr/local/libexec/kinvest-offline-image-attestation'
NETWORK_CONFIG='/etc/kinvest/metadata-network.conf'
PUBLIC_HEALTH_URL='https://dearmina.cn/api/health'

fail() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }
[[ "$#" -eq 0 ]] || fail DEPLOY_V5_ARGUMENTS_FORBIDDEN 2
[[ "$(id -u)" -eq 0 ]] || fail DEPLOY_V5_ROOT_REQUIRED
[[ -x "$CONTRACT" && -x "$OFFLINE_ATTESTATION" && -f "$COMPOSE" && ! -L "$COMPOSE" ]] || fail DEPLOY_V5_ASSETS_MISSING
[[ "$(findmnt -n -o FSTYPE --target "$RUN_ROOT" 2>/dev/null)" == tmpfs ]] || fail DEPLOY_V5_RUN_NOT_TMPFS
install -d -o root -g root -m 0700 -- "$STATE_ROOT" "$BACKUP_ROOT" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT"
exec 9>"$STATE_ROOT/deploy.lock"
flock -n 9 || fail DEPLOY_V5_LOCKED

payload_file=''
prepared_file=''
current_json=''
previous_json=''
plan_file=''
target_file=''
candidate_state=''
candidate_access_id='none'
candidate_access_path="$ACCESS_BUNDLE_ROOT/disabled"
candidate_ifind_id='none'
candidate_ifind_path=''
candidate_keep='false'
transaction_started='false'
current_image=''
current_access_path=''
current_ifind_path=''

safe_runtime_file() { [[ -n "${1:-}" && "$1" == "$RUN_ROOT"/kinvest-v5.* ]]; }

remove_tree_safe() {
  local root="$1" id="$2" path entry
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || return 0
  path="$root/$id"
  [[ "$path" == "$root"/* && -d "$path" && ! -L "$path" ]] || return 0
  chmod 0700 "$path" || return 1
  while IFS= read -r -d '' entry; do
    [[ -f "$entry" && ! -L "$entry" ]] || return 1
    rm -f -- "$entry" || return 1
  done < <(find "$path" -mindepth 1 -maxdepth 1 -print0)
  rmdir -- "$path"
}

prune_ifind_bundles() {
  local keep="$1" entry id
  [[ -d "$IFIND_BUNDLE_ROOT" && ! -L "$IFIND_BUNDLE_ROOT" ]] || return 1
  while IFS= read -r -d '' entry; do
    id="${entry##*/}"
    [[ "$id" =~ ^[0-9a-f]{32}$ ]] || return 1
    [[ "$id" == "$keep" ]] || remove_tree_safe "$IFIND_BUNDLE_ROOT" "$id"
  done < <(find "$IFIND_BUNDLE_ROOT" -mindepth 1 -maxdepth 1 -print0)
}

cleanup() {
  local status=$?
  trap - EXIT
  if [[ "$candidate_keep" != true ]]; then
    remove_tree_safe "$ACCESS_BUNDLE_ROOT" "$candidate_access_id"
    remove_tree_safe "$IFIND_BUNDLE_ROOT" "$candidate_ifind_id"
  fi
  for file in "$payload_file" "$prepared_file" "$current_json" "$previous_json" "$plan_file" "$target_file" "$candidate_state"; do
    safe_runtime_file "$file" && shred -u -z -- "$file" 2>/dev/null || true
  done
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

payload_file="$(mktemp "$RUN_ROOT/kinvest-v5.payload.XXXXXX")"
chmod 0600 "$payload_file"
dd bs=4096 count=5 of="$payload_file" status=none
[[ "$(wc -c <"$payload_file" | tr -d '[:space:]')" -le 16384 ]] || fail DEPLOY_V5_PAYLOAD_TOO_LARGE 2
grep -Fqx 'KINVEST_DEPLOY_V5' <(head -n 1 "$payload_file") || fail DEPLOY_V5_PAYLOAD_REJECTED 2

prepared_file="$(mktemp "$RUN_ROOT/kinvest-v5.prepared.XXXXXX")"
chmod 0600 "$prepared_file"
"$CONTRACT" validate-payload <"$payload_file" >"$prepared_file" || fail DEPLOY_V5_PAYLOAD_REJECTED 2

json_field() {
  python3 - "$1" "$2" <<'PY'
import json, sys
with open(sys.argv[1], encoding='ascii') as stream:
    value = json.load(stream)[sys.argv[2]]
print(json.dumps(value, separators=(',', ':'), sort_keys=True) if isinstance(value, (dict, list)) else value)
PY
}

materialize_bundles() {
  python3 - "$payload_file" "$ACCESS_BUNDLE_ROOT" "$IFIND_BUNDLE_ROOT" <<'PY'
import base64, hashlib, json, os, secrets, stat, sys

payload_path, access_root, ifind_root = sys.argv[1:]
flags = os.O_RDONLY | os.O_NOFOLLOW
fd = os.open(payload_path, flags)
try:
    raw = os.read(fd, 16385)
finally:
    os.close(fd)
lines = raw[:-1].split(b'\n')
if len(lines) != 16:
    raise SystemExit(2)
provider = lines[6].decode('ascii')
admin_version = lines[7].decode('ascii')
hmac_version = lines[8].decode('ascii')
ifind_mode = lines[12].decode('ascii')
ifind_version = lines[13].decode('ascii')

def atomic_file(directory, name, value):
    path = os.path.join(directory, name)
    file_fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o440)
    try:
        os.write(file_fd, value)
        os.fsync(file_fd)
    finally:
        os.close(file_fd)
    os.chown(path, 0, 10001, follow_symlinks=False)

result = {'accessId': 'none', 'accessPath': os.path.join(access_root, 'disabled'), 'ifindId': 'none', 'ifindPath': ''}
if provider == 'github-tmpfs-v1':
    admin = bytearray(base64.urlsafe_b64decode(lines[9] + b'=' * ((4 - len(lines[9]) % 4) % 4)))
    hmac = bytearray(lines[10])
    bundle_id = secrets.token_hex(16)
    bundle = os.path.join(access_root, bundle_id)
    os.mkdir(bundle, 0o750)
    os.chown(bundle, 0, 10001)
    try:
        manifest = json.dumps({
            'format': 'kinvest-github-tmpfs-v1',
            'adminPasswordVerifier': {'file': 'admin-password-verifier', 'versionId': admin_version, 'sha256': hashlib.sha256(admin).hexdigest()},
            'deviceTokenHmac': {'file': 'device-token-hmac-key', 'versionId': hmac_version, 'sha256': hashlib.sha256(hmac).hexdigest()},
        }, separators=(',', ':')).encode('ascii')
        atomic_file(bundle, 'manifest.json', manifest)
        atomic_file(bundle, 'admin-password-verifier', admin)
        atomic_file(bundle, 'device-token-hmac-key', hmac)
        os.chmod(bundle, 0o550)
        result.update(accessId=bundle_id, accessPath=bundle)
    finally:
        admin[:] = b'\0' * len(admin)
        hmac[:] = b'\0' * len(hmac)
elif provider != 'disabled':
    raise SystemExit(2)

if ifind_mode == 'diagnostic':
    token = bytearray(lines[14])
    bundle_id = secrets.token_hex(16)
    bundle = os.path.join(ifind_root, bundle_id)
    os.mkdir(bundle, 0o750)
    os.chown(bundle, 0, 10001)
    try:
        manifest = json.dumps({
            'format': 'kinvest-ifind-tmpfs-v1',
            'refreshToken': {'file': 'refresh-token', 'versionId': ifind_version, 'sha256': hashlib.sha256(token).hexdigest()},
        }, separators=(',', ':')).encode('ascii')
        atomic_file(bundle, 'manifest.json', manifest)
        atomic_file(bundle, 'refresh-token', token)
        os.chmod(bundle, 0o550)
        result.update(ifindId=bundle_id, ifindPath=bundle)
    finally:
        token[:] = b'\0' * len(token)
elif ifind_mode != 'disabled':
    raise SystemExit(2)
print(json.dumps(result, separators=(',', ':'), sort_keys=True))
PY
}

bundle_result="$(materialize_bundles)" || fail DEPLOY_V5_BUNDLE_CREATE_FAILED
candidate_access_id="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["accessId"])' <<<"$bundle_result")"
candidate_access_path="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["accessPath"])' <<<"$bundle_result")"
candidate_ifind_id="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["ifindId"])' <<<"$bundle_result")"
candidate_ifind_path="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["ifindPath"])' <<<"$bundle_result")"
unset bundle_result

if [[ "$candidate_access_id" == none ]]; then
  install -d -o root -g 10001 -m 0550 -- "$candidate_access_path"
fi

current_json="$(mktemp "$RUN_ROOT/kinvest-v5.current.XXXXXX")"
previous_json="$(mktemp "$RUN_ROOT/kinvest-v5.previous.XXXXXX")"
chmod 0600 "$current_json" "$previous_json"
[[ -f "$CURRENT_STATE" && ! -L "$CURRENT_STATE" ]] || fail DEPLOY_V5_CURRENT_STATE_MISSING
"$CONTRACT" parse-state <"$CURRENT_STATE" >"$current_json" || fail DEPLOY_V5_CURRENT_STATE_INVALID
if [[ -e "$PREVIOUS_STATE" ]]; then
  [[ -f "$PREVIOUS_STATE" && ! -L "$PREVIOUS_STATE" ]] || fail DEPLOY_V5_PREVIOUS_STATE_INVALID
  "$CONTRACT" parse-state <"$PREVIOUS_STATE" >"$previous_json" || fail DEPLOY_V5_PREVIOUS_STATE_INVALID
else
  printf 'null\n' >"$previous_json"
fi

plan_file="$(mktemp "$RUN_ROOT/kinvest-v5.plan.XXXXXX")"
chmod 0600 "$plan_file"
python3 - "$prepared_file" "$current_json" "$previous_json" <<'PY' | "$CONTRACT" resolve-intent >"$plan_file"
import json, sys
with open(sys.argv[1]) as stream: request = json.load(stream)
with open(sys.argv[2]) as stream: current = json.load(stream)
with open(sys.argv[3]) as stream: previous = json.load(stream)
request_fields = (
    'imageDigest', 'commit', 'secretProviderMode', 'secretVersionIds',
    'secretMaterialFingerprints', 'accessControlMode', 'ifindDiagnosticMode',
    'ifindRefreshTokenVersionId', 'ifindSecretMaterialFingerprint',
)
projected = {key: request[key] for key in request_fields}
print(json.dumps({'intent': request['intent'], 'request': projected, 'current': current, 'previous': previous}, separators=(',', ':'), sort_keys=True))
PY

intent="$(json_field "$prepared_file" intent)"
if [[ "$intent" == FORWARD ]]; then
  target_digest="$(json_field "$prepared_file" imageDigest)"
  target_commit="$(json_field "$prepared_file" commit)"
  target_file="$prepared_file"
else
  target_file="$(mktemp "$RUN_ROOT/kinvest-v5.target.XXXXXX")"
  chmod 0600 "$target_file"
  python3 - "$plan_file" >"$target_file" <<'PY'
import json, sys
with open(sys.argv[1]) as stream: print(json.dumps(json.load(stream)['target'], separators=(',', ':'), sort_keys=True))
PY
  target_digest="$(json_field "$target_file" imageDigest)"
  target_commit="$(json_field "$target_file" commit)"
fi
ifind_mode="$(json_field "$prepared_file" ifindDiagnosticMode)"
ifind_version="$(json_field "$prepared_file" ifindRefreshTokenVersionId)"
access_mode="$(json_field "$prepared_file" accessControlMode)"
provider="$(json_field "$prepared_file" secretProviderMode)"
versions="$(json_field "$prepared_file" secretVersionIds)"

run_docker() { timeout --signal=TERM --kill-after=10s 120s docker "$@"; }
inspect_id() { run_docker image inspect "$1" --format '{{.Id}}' 2>/dev/null; }
read_label() { run_docker image inspect "$1" --format "{{index .Config.Labels \"$2\"}}" 2>/dev/null; }
verify_repo_digest() { run_docker image inspect "$1" --format '{{json .RepoDigests}}' 2>/dev/null | grep -Fq -- "\"$2\""; }

resolve_offline_image() {
  local id
  id="$(timeout 15s "$OFFLINE_ATTESTATION" resolve "$target_digest" "$target_commit" "$(json_field "$prepared_file" verificationRunId)" 2>/dev/null)" || return 1
  [[ "$id" =~ ^sha256:[0-9a-f]{64}$ && "$(inspect_id "$id")" == "$id" ]] || return 1
  verify_repo_digest "$id" "$target_digest" || return 1
  printf '%s\n' "$id"
}

if [[ "$intent" == FORWARD ]]; then
  runtime_image_id="$(inspect_id "$target_digest" 2>/dev/null || true)"
  if [[ ! "$runtime_image_id" =~ ^sha256:[0-9a-f]{64}$ ]] || ! verify_repo_digest "$runtime_image_id" "$target_digest"; then
    runtime_image_id="$(resolve_offline_image)" || fail DEPLOY_V5_IMAGE_RESOLUTION_FAILED
  fi
else
  runtime_image_id="$(json_field "$target_file" runtimeImageId)"
  [[ "$(inspect_id "$runtime_image_id")" == "$runtime_image_id" ]] || fail DEPLOY_V5_STATE_IMAGE_MISMATCH
  verify_repo_digest "$runtime_image_id" "$target_digest" || [[ "$(resolve_offline_image)" == "$runtime_image_id" ]] || fail DEPLOY_V5_STATE_IMAGE_UNATTESTED
fi

schema_before="$(python3 - "$DATABASE" <<'PY'
import sqlite3, sys
with sqlite3.connect('file:' + sys.argv[1] + '?mode=ro', uri=True) as db: print(db.execute('PRAGMA user_version').fetchone()[0])
PY
)" || fail DEPLOY_V5_SCHEMA_READ_FAILED
schema_min="$(read_label "$runtime_image_id" io.kinvest.schema.min)"
schema_max="$(read_label "$runtime_image_id" io.kinvest.schema.max)"
[[ "$schema_min" =~ ^[0-9]+$ && "$schema_max" =~ ^[0-9]+$ && "$schema_before" -ge "$schema_min" && "$schema_before" -le "$schema_max" ]] || fail ROLLBACK_REQUIRES_DB_RESTORE 75
[[ "$(read_label "$runtime_image_id" io.kinvest.access-control.contract)" == 1 ]] || fail DEPLOY_V5_ACCESS_CONTRACT_INVALID
if [[ "$ifind_mode" == diagnostic ]]; then
  [[ "$(read_label "$runtime_image_id" io.kinvest.ifind-secret-bootstrap)" == 1 ]] || fail DEPLOY_V5_IFIND_PROVIDER_INCOMPATIBLE
fi

run_access_preflight() {
  run_docker run --rm --network none --read-only --cap-drop ALL --user 10001:10001 \
    --volume "$candidate_access_path:/run/secrets/kinvest:ro" \
    --env "KINVEST_SECRET_PROVIDER_MODE=$provider" --env "KINVEST_SECRET_VERSION_IDS=$versions" \
    --env KINVEST_SECRET_BUNDLE_PATH=/run/secrets/kinvest \
    --entrypoint node "$runtime_image_id" server/secret-preflight.js >/dev/null
}

run_ifind_preflight() {
  [[ "$ifind_mode" == diagnostic ]] || return 0
  run_docker run --rm --network none --read-only --cap-drop ALL --user 10001:10001 \
    --volume "$candidate_ifind_path:/run/secrets/kinvest-ifind:ro" \
    --env KINVEST_IFIND_DIAGNOSTIC_MODE=admin-diagnostic \
    --env "KINVEST_IFIND_REFRESH_TOKEN_VERSION_ID=$ifind_version" \
    --env KINVEST_IFIND_SECRET_BUNDLE_PATH=/run/secrets/kinvest-ifind \
    --entrypoint node "$runtime_image_id" server/ifind-secret-preflight.js >/dev/null
}

run_access_preflight || fail DEPLOY_V5_ACCESS_PREFLIGHT_FAILED
run_ifind_preflight || fail DEPLOY_V5_IFIND_PREFLIGHT_FAILED

verify_backup_file() {
  python3 - "$1" "$2" "$BACKUP_ROOT" <<'PY'
import hashlib, os, stat, sys
path, expected, root = sys.argv[1:]
if os.path.realpath(os.path.dirname(path)) != os.path.realpath(root) or os.path.basename(path) in ('', '.', '..'):
    raise SystemExit(1)
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1: raise SystemExit(1)
    digest = hashlib.file_digest(os.fdopen(os.dup(fd), 'rb'), 'sha256').hexdigest()
    if digest != expected: raise SystemExit(1)
finally: os.close(fd)
PY
}

backup_path='none'
backup_checksum='none'
create_database_backup() {
  local temporary
  backup_path="$BACKUP_ROOT/$(date -u +%Y%m%dT%H%M%SZ)-$target_commit.sqlite"
  temporary="$(mktemp "$BACKUP_ROOT/.backup-v5.XXXXXX")"
  python3 - "$DATABASE" "$temporary" <<'PY'
import sqlite3, sys
with sqlite3.connect('file:' + sys.argv[1] + '?mode=ro', uri=True) as source, sqlite3.connect(sys.argv[2]) as target:
    source.backup(target)
    if target.execute('PRAGMA quick_check').fetchone()[0] != 'ok': raise SystemExit(1)
PY
  chmod 0600 "$temporary"
  mv -- "$temporary" "$backup_path"
  backup_checksum="$(sha256sum "$backup_path" | awk '{print $1}')"
  verify_backup_file "$backup_path" "$backup_checksum"
}

if [[ "$intent" != RESTORE ]]; then create_database_backup || fail DEPLOY_V5_DATABASE_BACKUP_FAILED; fi

compose_up() {
  local profile service
  if [[ "$ifind_mode" == diagnostic ]]; then profile=ifind-diagnostic; service=kinvest-diagnostic; else profile=ifind-disabled; service=kinvest-disabled; fi
  (
    export COMPOSE_PROFILES="$profile" KINVEST_IMAGE="$runtime_image_id"
    export KINVEST_SECRET_PROVIDER_MODE="$provider" KINVEST_SECRET_VERSION_IDS="$versions"
    export KINVEST_SECRET_BUNDLE_HOST_PATH="$candidate_access_path"
    export KINVEST_ACCESS_CONTROL_MODE="$access_mode" KINVEST_TRUSTED_PROXY_ADDRESSES='["172.19.0.2"]'
    export KINVEST_IFIND_REFRESH_TOKEN_VERSION_ID="$ifind_version"
    export KINVEST_IFIND_SECRET_BUNDLE_HOST_PATH="$candidate_ifind_path"
    run_docker compose -f "$COMPOSE" --env-file "$NETWORK_CONFIG" up -d --remove-orphans "$service"
  )
}

atomic_state_from_json() {
  local source="$1" target="$2" prefix="$3" temporary
  temporary="$(mktemp "$STATE_ROOT/.${prefix}-v5.XXXXXX")"
  chmod 0600 "$temporary"
  if ! "$CONTRACT" canonical-state <"$source" >"$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  mv -f -- "$temporary" "$target"
}

atomic_state_from_text() {
  local source="$1" target="$2" prefix="$3" temporary
  temporary="$(mktemp "$STATE_ROOT/.${prefix}-v5.XXXXXX")"
  chmod 0600 "$temporary"
  cat -- "$source" >"$temporary" || { rm -f -- "$temporary"; return 1; }
  mv -f -- "$temporary" "$target"
}

candidate_state="$(mktemp "$RUN_ROOT/kinvest-v5.state.XXXXXX")"
chmod 0600 "$candidate_state"
python3 - "$target_file" "$prepared_file" "$current_json" "$runtime_image_id" "$schema_before" "$schema_min" "$schema_max" "$candidate_access_id" "$candidate_ifind_id" "$backup_path" "$backup_checksum" >"$candidate_state" <<'PY'
import datetime, json, sys
target_path, request_path, current_path, image_id, schema, minimum, maximum, access_id, ifind_id, backup, checksum = sys.argv[1:]
with open(target_path) as stream: target = json.load(stream)
with open(request_path) as stream: request = json.load(stream)
with open(current_path) as stream: current = json.load(stream)
state = dict(target) if 'protocolVersion' in target else {}
proxy_source = state if state else current
state.update({
  'protocolVersion': 6, 'imageDigest': request['imageDigest'] if not state else state['imageDigest'],
  'runtimeImageId': image_id, 'commit': request['commit'] if not state else state['commit'],
  'schemaVersion': int(schema), 'imageSchemaMin': int(minimum), 'imageSchemaMax': int(maximum),
  'secretProviderMode': request['secretProviderMode'], 'secretVersionIds': request['secretVersionIds'],
  'secretBundleId': access_id, 'secretMaterialFingerprints': request['secretMaterialFingerprints'],
  'accessControlMode': request['accessControlMode'], 'imageAccessControlContract': 1,
  'trustedProxyAddresses': proxy_source['trustedProxyAddresses'] if request['accessControlMode'] == 'device-approval' else [],
  'trustedProxyConfigChecksum': proxy_source['trustedProxyConfigChecksum'] if request['accessControlMode'] == 'device-approval' else '',
  'ifindDiagnosticMode': request['ifindDiagnosticMode'],
  'ifindRefreshTokenVersionId': request['ifindRefreshTokenVersionId'],
  'ifindSecretBundleId': ifind_id,
  'ifindSecretMaterialFingerprint': request['ifindSecretMaterialFingerprint'],
  'releaseRecordSchemaVersion': request['releaseRecordSchemaVersion'],
  'verificationRunId': request['verificationRunId'], 'artifactSource': request['artifactSource'],
  'databaseBackupPath': backup, 'databaseBackupChecksum': checksum,
  'deployedAt': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
})
print(json.dumps(state, separators=(',', ':'), sort_keys=True))
PY
"$CONTRACT" canonical-state <"$candidate_state" >"$candidate_state.text"
mv -- "$candidate_state.text" "$candidate_state"

printf 'phase=prepared\n' >"$JOURNAL"
chmod 0600 "$JOURNAL"
atomic_state_from_text "$candidate_state" "$ATTEMPT_STATE" attempt || fail DEPLOY_V5_STATE_WRITE_FAILED
transaction_started='true'
if [[ "$intent" != RESTORE ]]; then
  atomic_state_from_json "$current_json" "$PREVIOUS_STATE" previous || fail DEPLOY_V5_STATE_WRITE_FAILED
fi
compose_up || fail DEPLOY_V5_COMPOSE_FAILED

for _ in $(seq 1 60); do
  [[ "$(run_docker inspect --format '{{.State.Health.Status}}' kinvest 2>/dev/null || true)" == healthy ]] && break
  sleep 2
done
[[ "$(run_docker inspect --format '{{.State.Health.Status}}' kinvest 2>/dev/null || true)" == healthy ]] || fail DEPLOY_V5_HEALTH_FAILED
[[ "$(run_docker inspect --format '{{.Image}}' kinvest)" == "$runtime_image_id" ]] || fail DEPLOY_V5_RUNTIME_IMAGE_MISMATCH
curl -fsS --max-time 15 "$PUBLIC_HEALTH_URL" >/dev/null || fail DEPLOY_V5_PUBLIC_HEALTH_FAILED

current_temporary="$(mktemp "$STATE_ROOT/.current-v5.XXXXXX")"
chmod 0600 "$current_temporary"
cat -- "$candidate_state" >"$current_temporary" || fail DEPLOY_V5_STATE_WRITE_FAILED
mv -f -- "$current_temporary" "$CURRENT_STATE" || fail DEPLOY_V5_STATE_WRITE_FAILED
rm -f -- "$ATTEMPT_STATE" "$JOURNAL"
candidate_keep='true'
prune_ifind_bundles "$candidate_ifind_id" || fail DEPLOY_V5_CLEANUP_PENDING 71
printf 'KINVEST_DEPLOY_V5_OK intent=%s commit=%s ifind=%s\n' "$intent" "$target_commit" "$ifind_mode"
