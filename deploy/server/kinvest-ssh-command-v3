#!/usr/bin/env bash
set -euo pipefail

INSTALL_JOURNAL='/root/docker/kinvest/state/install-v4.journal'
INSTALL_LOCK="${INSTALL_JOURNAL%/*}/install-v4.lock"
if ! /usr/bin/flock -n "$INSTALL_LOCK" true; then
  printf '%s\n' 'DEPLOY_INSTALL_INCOMPLETE' >&2
  exit 76
fi
if [[ -e "$INSTALL_JOURNAL" || -L "$INSTALL_JOURNAL" ]]; then
  printf '%s\n' 'DEPLOY_INSTALL_INCOMPLETE' >&2
  exit 76
fi

if [[ "$#" -ne 0 ]]; then
  printf '%s\n' 'DEPLOY_V3_WRAPPER_ARGUMENTS_REJECTED' >&2
  exit 2
fi

# This dispatcher deliberately does not parse, buffer, or log stdin. It keeps
# deploy-v2 reachable during the disabled v3 baseline; protocol-v4 state then
# makes the legacy deployer fail closed until its explicit retirement.
case "${SSH_ORIGINAL_COMMAND:-}" in
  deploy-v2)
    exec sudo -n /usr/local/sbin/deploy-kinvest
    ;;
  deploy-v3)
    exec sudo -n /usr/local/sbin/deploy-kinvest-v3
    ;;
  deploy-v4)
    if [[ ! -x /usr/local/sbin/deploy-kinvest-v4 \
      || ! -x /usr/local/sbin/deploy-kinvest-v3 \
      || ! -x /usr/local/libexec/kinvest-deploy-v4-contract \
      || ! -x /usr/local/libexec/kinvest-deploy-v3-contract ]]; then
      printf '%s\n' 'DEPLOY_V4_ASSETS_MISSING' >&2
      exit 69
    fi
    exec sudo -n /usr/local/sbin/deploy-kinvest-v4
    ;;
  *)
    printf '%s\n' 'KINVEST_DEPLOY_WRAPPER_COMMAND_REJECTED' >&2
    exit 2
    ;;
esac
