#!/usr/bin/env bash
set -euo pipefail

GATE_STATE_DIR='/var/lib/kinvest-deploy-gate'
INSTALL_LOCK="$GATE_STATE_DIR/install.lock"
INSTALL_MARKER="$GATE_STATE_DIR/install-incomplete"

gate_incomplete() {
  printf '%s\n' 'DEPLOY_INSTALL_INCOMPLETE' >&2
  exit 76
}

validate_gate_state() {
  /usr/bin/python3 - "$GATE_STATE_DIR" "$INSTALL_LOCK" "$INSTALL_MARKER" <<'PY'
import os, stat, sys

directory, lock, marker = sys.argv[1:]
try:
    directory_info = os.lstat(directory)
    lock_info = os.lstat(lock)
    if (
        not stat.S_ISDIR(directory_info.st_mode)
        or stat.S_IMODE(directory_info.st_mode) != 0o755
        or directory_info.st_uid != 0
        or directory_info.st_gid != 0
        or not stat.S_ISREG(lock_info.st_mode)
        or stat.S_IMODE(lock_info.st_mode) != 0o644
        or lock_info.st_uid != 0
        or lock_info.st_gid != 0
        or lock_info.st_nlink != 1
    ):
        raise OSError("unsafe gate state")
    if os.path.lexists(marker):
        marker_info = os.lstat(marker)
        if (
            not stat.S_ISREG(marker_info.st_mode)
            or stat.S_IMODE(marker_info.st_mode) != 0o644
            or marker_info.st_uid != 0
            or marker_info.st_gid != 0
            or marker_info.st_nlink != 1
        ):
            raise OSError("unsafe gate marker")
        with open(marker, "rb") as stream:
            if stream.read(8) != b"ACTIVE\n" or stream.read(1) != b"":
                raise OSError("invalid gate marker")
        print("ACTIVE")
    else:
        print("CLEAN")
except OSError:
    raise SystemExit(1)
PY
}

gate_status="$(validate_gate_state)" || gate_incomplete
[[ "$gate_status" == CLEAN ]] || gate_incomplete
exec 8<"$INSTALL_LOCK" || gate_incomplete
/usr/bin/flock -n -s 8 || gate_incomplete
gate_status="$(validate_gate_state)" || gate_incomplete
[[ "$gate_status" == CLEAN ]] || gate_incomplete

if [[ "$#" -ne 0 ]]; then
  printf '%s\n' 'DEPLOY_V3_WRAPPER_ARGUMENTS_REJECTED' >&2
  exit 2
fi

# This dispatcher deliberately does not parse, buffer, or log stdin. It keeps
# deploy-v2 reachable during the disabled v3 baseline; protocol-v4 state then
# makes the legacy deployer fail closed until its explicit retirement.
case "${SSH_ORIGINAL_COMMAND:-}" in
  deploy-v2)
    exec sudo -n /usr/local/sbin/deploy-kinvest
    ;;
  deploy-v3)
    exec sudo -n /usr/local/sbin/deploy-kinvest-v3
    ;;
  deploy-v4)
    if [[ ! -x /usr/local/sbin/deploy-kinvest-v4 \
      || ! -x /usr/local/sbin/deploy-kinvest-v3 \
      || ! -x /usr/local/libexec/kinvest-deploy-v4-contract \
      || ! -x /usr/local/libexec/kinvest-deploy-v3-contract ]]; then
      printf '%s\n' 'DEPLOY_V4_ASSETS_MISSING' >&2
      exit 69
    fi
    exec sudo -n /usr/local/sbin/deploy-kinvest-v4
    ;;
  *)
    printf '%s\n' 'KINVEST_DEPLOY_WRAPPER_COMMAND_REJECTED' >&2
    exit 2
    ;;
esac
