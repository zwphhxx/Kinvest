{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "punycode": [
        "./node_modules/@types/node/punycode.d.ts"
      ]
    }
  },
  "include": [
    "server/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
