{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "server/**/*.js",
    "scripts/**/*.js",
    "public/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
